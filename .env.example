# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- TimescaleDB (required) ---
TIMESCALE_DB=poly_detector
TIMESCALE_USER=poly
TIMESCALE_PASS=

# --- Image registry (required; lowercase GitHub user or org that owns the images) ---
GHCR_OWNER=

# --- Optional (defaults shown) ---
# IMAGE_TAG=latest             # server: set by the deploy to the commit being released
# CLOSING_WINDOW_HOURS=24      # only watch markets that close within this many hours
# CLOSING_GRACE_HOURS=6        # ...and keep watching this long after endDate (trading goes on until resolution)
# POLL_INTERVAL_SECONDS=60
# TRADE_BACKFILL_HOURS=24      # how far back to fetch trades for a market seen the first time
# SPIKE_WINDOW_MINUTES=5
# SPIKE_HISTORY_MINUTES=60
# SPIKE_FACTOR=5
# SPIKE_MIN_NOTIONAL=1000      # USDC
# LOG_LEVEL=INFO

# --- Server only ---
# TIMESCALE_DATA_DIR=/mnt/data/postgres  # DB files on the attached block storage (see docs/deploy.md)
# HEALTHCHECK_URL=             # dead man's switch ping URL (e.g. healthchecks.io), see docs/deploy.md
# BACKUP_KEEP=3                # number of DB dumps kept by scripts/backup.sh
