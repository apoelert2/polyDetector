# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- TimescaleDB (required) ---
TIMESCALE_DB=poly_detector
TIMESCALE_USER=poly
TIMESCALE_PASS=

# --- Optional (defaults shown) ---
# CLOSING_WINDOW_HOURS=24      # only watch markets that close within this many hours
# POLL_INTERVAL_SECONDS=60
# TRADE_BACKFILL_HOURS=24      # how far back to fetch trades for a market seen the first time
# SPIKE_WINDOW_MINUTES=5
# SPIKE_HISTORY_MINUTES=60
# SPIKE_FACTOR=5
# SPIKE_MIN_NOTIONAL=1000      # USDC
# LOG_LEVEL=INFO
